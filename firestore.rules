rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL DEFAULT-DENY SAFETY NET
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. REUSABLE HARDENED PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'akashreddymaligireddy@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // 3. ENTITY VALIDATION BLUEPRINTS (Synced verbatim with firebase-blueprint.json)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.role is string && data.role in ['contributor', 'reviewer', 'admin'] &&
        data.createdAt is timestamp;
    }

    function isValidTranslationRecord(data) {
      return data.keys().hasAll([
          'userId', 'targetLanguage', 'englishText', 'translatedText', 'secondaryText', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'targetLanguage', 'englishText', 'translatedText', 'secondaryText', 'createdAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.targetLanguage is string && data.targetLanguage in ['telugu', 'gondi'] &&
        data.englishText is string && data.englishText.size() >= 1 && data.englishText.size() <= 1000 &&
        data.translatedText is string && data.translatedText.size() >= 1 && data.translatedText.size() <= 1200 &&
        data.secondaryText is string && data.secondaryText.size() <= 1200 &&
        data.createdAt is timestamp;
    }

    // =========================================================================
    // 4. COLLECTION RULES
    // =========================================================================

    // /admins/{adminId} — Read-only role verification documents
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // /users/{userId} — PII-isolated private user profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().email == request.auth.token.email &&
        incoming().role == 'contributor' &&
        incoming().createdAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt && (
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])
          ) || (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role'])
          )
        );

      allow delete: if false;
    }

    // /translations/{translationId} — Private English-to-Telugu & English-to-Gondi history
    match /translations/{translationId} {
      allow get: if isSignedIn() &&
        isValidId(translationId) &&
        (existing().userId == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
        resource.data.userId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(translationId) &&
        isValidTranslationRecord(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser() &&
        isValidId(translationId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
